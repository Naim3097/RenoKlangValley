---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyBand from '../components/StickyBand.astro';
import JsonLd from '../components/JsonLd.astro';
import { SITE } from '../lib/site';
import { organizationSchema, websiteSchema } from '../lib/schema';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  locale?: 'en' | 'ms';
  alternates?: Array<{ locale: 'en' | 'ms'; href: string }>;
}

const {
  title,
  description,
  canonical = new URL(Astro.url.pathname, SITE.url).toString(),
  ogImage = `${SITE.url}/og-default.jpg`,
  noindex = false,
  locale = 'en',
  alternates = [],
} = Astro.props;

const htmlLang = locale === 'ms' ? 'ms-MY' : 'en-MY';
const fullTitle = title.includes(SITE.name) ? title : `${title} — ${SITE.name}`;
---
<!doctype html>
<html lang={htmlLang}>
<head>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-CEYRZ7RJQ3" is:inline></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-CEYRZ7RJQ3');
  </script>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
  <meta name="theme-color" content="#f3ede2" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex,follow" />}
  {!noindex && <meta name="robots" content="index,follow,max-image-preview:large" />}

  {alternates.map((a) => (
    <link rel="alternate" hreflang={a.locale === 'ms' ? 'ms-MY' : 'en-MY'} href={a.href} />
  ))}
  {alternates.length > 0 && (
    <link rel="alternate" hreflang="x-default" href={alternates.find((a) => a.locale === 'en')?.href ?? canonical} />
  )}

  <meta property="og:type" content="website" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:locale" content={htmlLang.replace('-', '_')} />
  <meta name="twitter:card" content="summary_large_image" />

  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
  />

  <JsonLd data={organizationSchema()} />
  <JsonLd data={websiteSchema()} />

  {SITE.analytics.plausibleDomain && (
    <script
      defer
      data-domain={SITE.analytics.plausibleDomain}
      src="https://plausible.io/js/script.js"
      is:inline
    ></script>
  )}
</head>
<body class="min-h-screen flex flex-col bg-paper text-ink antialiased">
  <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:bg-ink focus:text-paper focus:px-3 focus:py-2 focus:rounded">Skip to content</a>
  <Header />
  <main id="main" class="flex-1">
    <slot />
  </main>
  <Footer />
  <StickyBand />
</body>
</html>
