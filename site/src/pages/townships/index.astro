---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import JsonLd from '../../components/JsonLd.astro';
import { getCollection } from 'astro:content';
import { breadcrumbSchema } from '../../lib/schema';
import { SITE } from '../../lib/site';

const articles = (await getCollection('articles', ({ data }) => !data.draft && data.locale === 'en' && data.category === 'townships'))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Townships' },
];
---
<BaseLayout
  title="Klang Valley Township Renovation Guide"
  description="Township-specific renovation guides for Eco Ardence, Setia Alam, Bandar Rimbayu, Kwasa Damansara, Cyberjaya and more."
>
  <section class="max-w-[1200px] mx-auto px-6 pt-10 pb-12">
    <Breadcrumb items={crumbs} />
    <div class="grid md:grid-cols-12 gap-x-10 gap-y-8 mt-10">
      <div class="md:col-span-2">
        <p class="kicker">N° 02 — Desk</p>
      </div>
      <div class="md:col-span-9">
        <h1 class="font-serif tracking-tight leading-[1.02] text-[40px] md:text-[68px]" style="font-weight: 400;">
          Township by township, the way it really works.
        </h1>
        <p class="font-serif text-[20px] md:text-[22px] text-ink-soft mt-7 leading-[1.5] max-w-[58ch]" style="font-weight: 400;">
          Eco Ardence has architectural committees. Cyberjaya condos have JMB rules nobody warns you about. Setia Alam sub-sales have wiring you really need to look at. Every township carries its own list of small surprises — here’s ours.
        </p>
      </div>
    </div>
  </section>

  <div class="max-w-[1200px] mx-auto px-6">
    <div class="border-t rule-strong"></div>
    <div class="border-t rule mt-[3px]"></div>
  </div>

  <section class="max-w-[1200px] mx-auto px-6 py-12">
    <div class="grid md:grid-cols-12 gap-x-10 mb-8">
      <p class="md:col-span-2 kicker">Index</p>
      <p class="md:col-span-10 text-ink-soft text-[14px]">All township pieces. Newest first.</p>
    </div>
    <ol class="divide-y rule border-y rule-strong">
      {articles.map((a, i) => {
        const slug = a.id.replace(/\.(md|mdx)$/, '').split('/').pop();
        return (
          <li>
            <a href={`/townships/${slug}/`} class="group grid grid-cols-12 gap-4 py-7 items-baseline">
              <span class="index-num col-span-2 md:col-span-1">{String(i + 1).padStart(2, '0')}</span>
              <span class="font-serif text-[22px] md:text-[26px] leading-[1.2] col-span-10 md:col-span-9 group-hover:text-brand transition" style="font-weight: 400;">
                {a.data.title}
              </span>
              <span class="hidden md:inline col-span-2 text-[12px] font-mono uppercase tracking-[0.14em] text-muted text-right">Read →</span>
              <p class="col-span-12 md:col-start-2 md:col-span-9 text-[14px] text-muted leading-relaxed line-clamp-2 -mt-2">{a.data.description}</p>
            </a>
          </li>
        );
      })}
    </ol>
  </section>

  <JsonLd data={breadcrumbSchema(crumbs.map((c) => ({ name: c.name, url: new URL(c.href ?? Astro.url.pathname, SITE.url).toString() })))} />
</BaseLayout>
