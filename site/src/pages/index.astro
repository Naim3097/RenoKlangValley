---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles', ({ data }) => !data.draft && data.locale === 'en'))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const featured = articles[0];
const secondary = articles.slice(1, 4);
const rest = articles.slice(4, 10);

const sections = [
  {
    num: '01',
    href: '/contractors/',
    title: 'Contractors',
    blurb: 'Who we’d actually call back. Site visits, contract reads, the boring proof.',
  },
  {
    num: '02',
    href: '/townships/',
    title: 'Townships',
    blurb: 'House-by-house. Eco Ardence, Setia Alam, Bandar Rimbayu, Cyberjaya, more.',
  },
  {
    num: '03',
    href: '/checklists/',
    title: 'Checklists',
    blurb: 'The lists we made for ourselves first. Print them, ignore the agent.',
  },
];

const slugOf = (a: typeof articles[number]) => a.id.replace(/\.(md|mdx)$/, '').split('/').pop();
const hrefOf = (a: typeof articles[number]) => `/${a.data.category}/${slugOf(a)}/`;
const dateFmt = (d: Date) => new Intl.DateTimeFormat('en-MY', { day: 'numeric', month: 'short', year: 'numeric' }).format(d);
const thumbOf = (a: typeof articles[number], w = 800) => {
  const id = a.data.heroUrl;
  if (!id) return null;
  if (id.startsWith('http')) return id;
  return `https://images.unsplash.com/${id}?auto=format&fit=crop&w=${w}&q=75`;
};
---
<BaseLayout
  title="Reno Klang Valley — Honest renovation guides for KV homeowners"
  description="Independent renovation reporting from Selangor. Contractor reviews, township-specific guides, and the checklists agents won’t hand you."
>
  <!-- HERO — editorial cover -->
  <section class="max-w-[1200px] mx-auto px-6 pt-10 md:pt-16 pb-20">
    <div class="grid md:grid-cols-12 gap-x-10 gap-y-10">
      <div class="md:col-span-1 hidden md:block">
        <p class="index-num" style="writing-mode: vertical-rl; transform: rotate(180deg);">Vol. 01 — Issue 01</p>
      </div>

      <div class="md:col-span-7">
        <p class="kicker mb-6">From the desk — Selangor</p>
        <h1 class="font-serif tracking-tight leading-[0.96] text-[44px] sm:text-[64px] md:text-[88px]" style="font-weight: 600; letter-spacing: -0.025em;">
          The renovation<br/>
          notebook we’d<br/>
          <em class="not-italic text-brand">have wanted</em><br/>
          ourselves.
        </h1>
      </div>

      <div class="md:col-span-4 md:pt-32">
        <p class="font-serif text-[19px] md:text-[20px] leading-[1.55] text-ink" style="font-weight: 400;">
          Reno Klang Valley is a small editorial about renovating houses in Selangor. We pay
          for our own inspections, we read the contracts, and we say what we think. No paid
          listings. No “top ten” laundry. Just the working notes from people who’ve done it.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-x-7 gap-y-3 text-[13px]">
          <a href="/contractors/" class="border-b border-ink pb-0.5 hover:text-brand hover:border-brand transition">Contractor desk →</a>
          <a href="/about/" class="text-ink-soft hover:text-ink border-b border-transparent hover:border-ink pb-0.5 transition">How we work</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Hairline divider — newspaper rule -->
  <div class="max-w-[1200px] mx-auto px-6">
    <div class="border-t rule-strong"></div>
    <div class="border-t rule mt-[3px]"></div>
  </div>

  <!-- FEATURED + SECONDARY — asymmetric editorial grid -->
  {featured && (
    <section class="max-w-[1200px] mx-auto px-6 py-16">
      <div class="flex items-baseline justify-between mb-10">
        <p class="kicker">This week — on the desk</p>
        <span class="index-num">N° — 01</span>
      </div>

      <div class="grid md:grid-cols-12 gap-x-10 gap-y-12">
        <article class="md:col-span-7 md:pr-6">
          <a href={hrefOf(featured)} class="group block">
            {thumbOf(featured, 1400) && (
              <div class="mb-7 overflow-hidden bg-paper-deep aspect-[16/10]">
                <img
                  src={thumbOf(featured, 1400)!}
                  alt={featured.data.heroAlt ?? featured.data.title}
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                  class="w-full h-full object-cover group-hover:scale-[1.02] transition duration-700"
                  style="filter: saturate(0.92) contrast(0.96);"
                />
              </div>
            )}
            <p class="kicker mb-4">{featured.data.category}</p>
            <h2 class="font-serif text-[34px] md:text-[52px] leading-[1.04] tracking-tight max-w-[18ch] group-hover:text-brand transition" style="font-weight: 400;">
              {featured.data.title}
            </h2>
            <p class="mt-6 text-[17px] text-ink-soft leading-[1.6] max-w-[58ch]">
              {featured.data.description}
            </p>
            <p class="mt-6 text-[13px] text-muted">
              <time>{dateFmt(featured.data.publishedAt)}</time> · by Aisyah Rahman
            </p>
          </a>
        </article>

        <div class="md:col-span-5 md:border-l rule md:pl-10 space-y-9">
          {secondary.map((a, i) => (
            <a href={hrefOf(a)} class="group block pb-9 border-b last:border-b-0 rule">
              {thumbOf(a, 600) && (
                <div class="mb-4 overflow-hidden bg-paper-deep aspect-[4/3]">
                  <img src={thumbOf(a, 600)!} alt={a.data.heroAlt ?? a.data.title} loading="lazy" decoding="async" class="w-full h-full object-cover group-hover:scale-[1.02] transition duration-700" style="filter: saturate(0.92) contrast(0.96);" />
                </div>
              )}
              <div class="flex items-baseline gap-4 mb-2">
                <span class="index-num">{String(i + 2).padStart(2, '0')}</span>
                <span class="kicker">{a.data.category}</span>
              </div>
              <h3 class="font-serif text-[22px] leading-[1.18] group-hover:text-brand transition" style="font-weight: 400;">
                {a.data.title}
              </h3>
              <p class="mt-2 text-[14px] text-muted leading-relaxed line-clamp-2">{a.data.description}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- SECTIONS — three desks, asymmetric -->
  <section class="bg-paper-deep border-y rule-strong">
    <div class="max-w-[1200px] mx-auto px-6 py-20">
      <div class="grid md:grid-cols-12 gap-x-10 gap-y-12">
        <div class="md:col-span-4">
          <p class="kicker mb-4">The three desks</p>
          <p class="font-serif text-[28px] md:text-[34px] leading-[1.15] tracking-tight" style="font-weight: 400;">
            We’re not trying to cover everything. Just the three things that
            actually move the needle when you’re renovating in&nbsp;KV.
          </p>
        </div>

        <div class="md:col-span-8 grid sm:grid-cols-3 gap-8">
          {sections.map((s) => (
            <a href={s.href} class="group block border-t-2 border-ink pt-5 hover:border-brand transition">
              <p class="index-num">N° {s.num}</p>
              <h3 class="font-serif text-[26px] leading-tight mt-2 group-hover:text-brand transition" style="font-weight: 400;">{s.title}</h3>
              <p class="text-[14px] text-ink-soft mt-3 leading-relaxed">{s.blurb}</p>
              <p class="text-[12px] mt-5 font-mono uppercase tracking-[0.14em] text-ink group-hover:text-brand">Open desk →</p>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ARCHIVE LIST — newspaper TOC style -->
  {rest.length > 0 && (
    <section class="max-w-[1200px] mx-auto px-6 py-20">
      <div class="grid md:grid-cols-12 gap-x-10 gap-y-6 mb-10">
        <div class="md:col-span-4">
          <p class="kicker mb-4">Archive — recent pieces</p>
          <p class="font-serif text-[26px] leading-[1.2]" style="font-weight: 400;">Older notes, kept up to date when prices shift.</p>
        </div>
        <div class="md:col-span-8 md:pt-10">
          <a href="/articles/" class="text-[13px] border-b border-ink pb-0.5 hover:text-brand hover:border-brand transition">Read everything →</a>
        </div>
      </div>

      <ol class="divide-y rule border-y rule-strong">
        {rest.map((a, i) => (
          <li>
            <a href={hrefOf(a)} class="group grid grid-cols-12 gap-4 py-6 items-center">
              <span class="index-num col-span-2 md:col-span-1">{String(i + 5).padStart(2, '0')}</span>
              {thumbOf(a, 280) ? (
                <div class="col-span-3 md:col-span-2 overflow-hidden bg-paper-deep aspect-[4/3]">
                  <img src={thumbOf(a, 280)!} alt="" loading="lazy" decoding="async" class="w-full h-full object-cover group-hover:scale-[1.04] transition duration-500" style="filter: saturate(0.92) contrast(0.96);" />
                </div>
              ) : <span class="hidden md:block md:col-span-2"></span>}
              <span class="kicker col-span-7 md:col-span-2">{a.data.category}</span>
              <span class="font-serif text-[18px] md:text-[20px] leading-[1.25] col-span-12 md:col-span-5 group-hover:text-brand transition" style="font-weight: 400;">
                {a.data.title}
              </span>
              <span class="text-[12px] font-mono text-muted col-span-12 md:col-span-2 md:text-right">{dateFmt(a.data.publishedAt)}</span>
            </a>
          </li>
        ))}
      </ol>
    </section>
  )}

  <!-- FOOT QUOTE — editorial closer -->
  <section class="max-w-[1200px] mx-auto px-6 pb-24">
    <div class="grid md:grid-cols-12 gap-x-10">
      <div class="md:col-span-2 hidden md:block">
        <p class="index-num">N° — ED</p>
      </div>
      <blockquote class="md:col-span-8 font-serif text-[28px] md:text-[40px] leading-[1.18] tracking-tight" style="font-weight: 350;">
        “The cheapest renovation is the one where nothing surprises you. Surprises are
        almost always caused by skipping the boring part.”
      </blockquote>
      <p class="md:col-span-2 mt-4 md:mt-2 kicker md:text-right">Aisyah — Editor</p>
    </div>

    <!-- Single editorial mention. One follow link from homepage to BINA+,
         outside the nav/footer, in a contextually justified editor's note.
         Anchor varies from /about/ (uses brand) to a partial-match phrase. -->
    <div class="grid md:grid-cols-12 gap-x-10 mt-16 pt-10 border-t rule">
      <aside class="md:col-span-2 hidden md:block">
        <p class="kicker">P.S.</p>
      </aside>
      <p class="md:col-span-8 text-[15px] text-ink-soft leading-[1.7] max-w-[58ch]">
        If you'd rather skip the shortlist round and just talk to the one studio we keep recommending, that's
        <a href="https://binaplus.my/" class="underline underline-offset-4 decoration-ink/30 hover:decoration-ink"> the Shah Alam team behind BINA+</a> — their <a href="/packages/" class="underline underline-offset-4 decoration-ink/30 hover:decoration-ink">published packages</a> start at RM75k for condos.
        We've explained the why on <a href="/about/" class="underline underline-offset-4 decoration-ink/30 hover:decoration-ink">the about page</a>.
      </p>
    </div>
  </section>
</BaseLayout>
